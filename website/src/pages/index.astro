		<div id="lightbox" class="fixed inset-0 z-[100] bg-black/95 backdrop-blur-md flex items-center justify-center p-8 md:p-24 opacity-0 pointer-events-none transition-opacity duration-500 cursor-zoom-out">
			<button id="prev-lightbox" class="absolute left-4 md:left-12 z-[110] text-white/50 hover:text-white transition-all hover:scale-125 hover:-translate-x-2 p-4 cursor-hover"><svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"></path></svg></button>
