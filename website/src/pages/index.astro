			<button id="next-lightbox" class="absolute right-4 md:right-12 z-[110] text-white/50 hover:text-white transition-all hover:scale-125 hover:translate-x-2 p-4 cursor-hover"><svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"></path></svg></button>
			<button id="close-lightbox" class="absolute top-8 right-8 text-white/50 hover:text-white hover:scale-125 hover:rotate-90 transition-all duration-300 z-[120] cursor-hover"><svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"></path></svg></button>
