---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

// Fetch latest release
let latestVersion = "v0.3.40"; // Fallback
try {
	const res = await fetch('https://api.github.com/repos/Lasikiewicz/onyx/releases/latest');
	if (res.ok) {
		const data = await res.json();
		latestVersion = data.tag_name || latestVersion;
	}
} catch (e) {
	console.error("Failed to fetch latest release logic:", e);
}

// Feature data for the expanded showcase
const collectionViews = [
	{ 
		title: 'Cover Flow View', 
		images: ['/Screenshots/Cover Flow View.png', '/Screenshots/Cover Flow View 1.png', '/Screenshots/Cover Flow View 2.png'], 
		desc: 'Glide through your games with a stunning, sweeping 3D effect.<br/>Flip through your library like an interactive collection of vinyl records.' 
	},
	{ 
		title: 'Grid View', 
		images: ['/Screenshots/Grid View.png', '/Screenshots/Grid View 1.png', '/Screenshots/Grid View 2.png', '/Screenshots/Grid View 3.png', '/Screenshots/Grid View 4.png'], 
		desc: 'A refined presentation of your library, balancing visual impact with efficient browsing.<br/>The gold standard for any digital collection, optimized for clarity.' 
	},
	{ 
		title: 'List View', 
		images: ['/Screenshots/List View.png', '/Screenshots/List View 1.png', '/Screenshots/List View 2.png', '/Screenshots/List View 3.png', '/Screenshots/List View 4.png'], 
		desc: 'Engineered for the organized mind.<br/>A high-density information display that puts your metadata front and center for rapid sorting and surgical management.' 
	},
	{ 
		title: 'Logo View', 
		images: ['/Screenshots/Logo View.png', '/Screenshots/Logo View 1.png', '/Screenshots/Logo View 2.png', '/Screenshots/Logo View 3.png', '/Screenshots/Logo View 4.png'], 
		desc: 'Strip away the noise and let the branding shine.<br/>A minimalist approach that treats your games like a gallery of icons, focusing purely on visual identity.' 
	},
	{ 
		title: 'Carousel View', 
		images: ['/Screenshots/Carousel View.png', '/Screenshots/Carousel View 1.png', '/Screenshots/Carousel View 2.png', '/Screenshots/Carousel View 3.png', '/Screenshots/Carousel View 4.png'], 
		desc: 'Transform your library into a cinematic showcase.<br/>Full-bleed artwork and sweeping transitions create an atmospheric experience that feels alive.' 
	},
];

const backgroundImages = collectionViews.map(view => view.images[0]);

const managementTools = [
	{ 
		title: 'Metadata Mastery', 
		images: ['/Screenshots/Game Manager - Metadata.png', '/Screenshots/Game Manager - Metadata 1.png', '/Screenshots/Game Manager - Metadata 2.png'], 
		desc: 'Surgical precision for your game data.<br/>Edit titles, release dates, and developers with a suite of professional tools built for the librarian in every gamer.' 
	},
	{ 
		title: 'Visual Search', 
		images: ['/Screenshots/Game Manager - Image Search.png', '/Screenshots/Game Manager - Image Search 1.png', '/Screenshots/Game Manager - Image Search 2.png'], 
		desc: 'Never settle for low-resolution assets again.<br/>Our integrated high-definition search engine fetches stunning box art and banners from multiple sources instantly.' 
	},
	{ 
		title: 'Contextual Ease', 
		images: ['/Screenshots/Game Right Click Menu.png'], 
		desc: 'Intuitive navigation that feels like second nature.<br/>Effortless right-click menus and smart shortcuts keep the power exactly where you expect it to be.' 
	},
	{ 
		title: 'Mod Manager linking', 
		images: ['/Screenshots/ModManager.png'], 
		desc: 'Launch your mod manager from the library.<br/>Right-click any game or use the Mod Manager button in the details panel to open your preferred mod tool for that title.' 
	},
];

const advancedFeatures = [
	{ title: 'Unified Importer', images: ['/Screenshots/Game Importer.png'], desc: 'Break down the walls between platforms.<br/>An intelligent one-click integration for Steam, Epic, GOG, and beyond, consolidated into a single universe.' },
	{ title: 'Deep Configuration', images: ['/Screenshots/Settings.png'], desc: 'Your library, your rules.<br/>From performance tweaks to sophisticated UI behavior, customize every layer of Onyx to fit your exact specifications.' },
	{ title: 'View Personalization', images: ['/Screenshots/View Options.png'], desc: 'Total aesthetic control for the discerning user.<br/>Adjust scaling, spacing, and accent colors to create a workspace that is uniquely yours.' },
];
---

<Layout title="Onyx | Unified Game Library">
	<div id="custom-cursor"></div>
	<main id="top" class="min-h-screen bg-[#0f172a] selection:bg-onyx-accent/30 overflow-hidden relative">
		
		<!-- Ambient Background -->
		<div class="fixed inset-0 z-0 overflow-hidden pointer-events-none">
			<div class="ambient-orb orb-1 absolute w-[500px] h-[500px] rounded-full bg-sky-500/20 blur-[120px] -top-[200px] -left-[200px] animate-pulse"></div>
			<div class="ambient-orb orb-2 absolute w-[400px] h-[400px] rounded-full bg-sky-600/20 blur-[120px] top-[40%] right-[10%] animate-pulse" style="animation-delay: 2s"></div>
			<div class="ambient-orb orb-3 absolute w-[600px] h-[600px] rounded-full bg-indigo-600/10 blur-[150px] bottom-[-200px] left-[20%] animate-pulse" style="animation-delay: 4s"></div>
		</div>

		<!-- Navigation -->
		<nav id="navbar" class="fixed top-0 w-full z-50 px-8 py-6 onyx-nav-thin transition-all duration-300">
			<div class="max-w-7xl mx-auto relative flex items-center justify-between">
				<a href="#top" class="flex items-center gap-3 flex-shrink-0 text-inherit hover:scale-110 transition-transform cursor-hover">
					<div class="relative group">
						<div class="absolute inset-0 bg-sky-400 blur-md opacity-0 group-hover:opacity-50 transition-opacity"></div>
						<img src="/logo.svg" alt="Onyx Logo" class="w-10 h-10 relative z-10 animate-rotate" />
					</div>
					<span class="text-2xl font-black tracking-tighter text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-400">Onyx</span>
				</a>
				
				<div class="hidden md:flex absolute left-1/2 -translate-x-1/2 items-center gap-10">
					<div class="relative group">
						<a href="#features" class="text-slate-300 hover:text-white text-sm font-bold tracking-wider uppercase transition-colors flex items-center gap-2 py-2 cursor-hover">
							Views
							<svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
							<span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-onyx-accent transition-all duration-300 group-hover:w-full"></span>
						</a>
						<div class="absolute top-full left-1/2 -translate-x-1/2 mt-4 min-w-[200px] glass-panel rounded-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50 py-3 transform group-hover:translate-y-0 translate-y-4">
							<a href="#grid-view" class="block px-6 py-3 text-slate-300 hover:text-white hover:bg-white/10 hover:pr-4 hover:pl-8 text-sm transition-all duration-300 font-medium cursor-hover">Grid View</a>
							<a href="#list-view" class="block px-6 py-3 text-slate-300 hover:text-white hover:bg-white/10 hover:pr-4 hover:pl-8 text-sm transition-all duration-300 font-medium cursor-hover">List View</a>
							<a href="#logo-view" class="block px-6 py-3 text-slate-300 hover:text-white hover:bg-white/10 hover:pr-4 hover:pl-8 text-sm transition-all duration-300 font-medium cursor-hover">Logo View</a>
							<a href="#carousel-view" class="block px-6 py-3 text-slate-300 hover:text-white hover:bg-white/10 hover:pr-4 hover:pl-8 text-sm transition-all duration-300 font-medium cursor-hover">Carousel View</a>
							<a href="#cover-flow-view" class="block px-6 py-3 text-slate-300 hover:text-white hover:bg-white/10 hover:pr-4 hover:pl-8 text-sm transition-all duration-300 font-medium cursor-hover">Cover Flow View</a>
						</div>
					</div>

					<div class="relative group">
						<a href="#features" class="text-slate-300 hover:text-white text-sm font-bold tracking-wider uppercase transition-colors flex items-center gap-2 py-2 cursor-hover">
							Features
							<svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
							<span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-onyx-accent transition-all duration-300 group-hover:w-full"></span>
						</a>
						<div class="absolute top-full left-1/2 -translate-x-1/2 mt-4 min-w-[240px] glass-panel rounded-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50 py-3 transform group-hover:translate-y-0 translate-y-4">
							<a href="#metadata-mastery" class="block px-6 py-3 text-slate-300 hover:text-white hover:bg-white/10 hover:pr-4 hover:pl-8 text-sm transition-all duration-300 font-medium cursor-hover">Metadata Mastery</a>
							<a href="#visual-search" class="block px-6 py-3 text-slate-300 hover:text-white hover:bg-white/10 hover:pr-4 hover:pl-8 text-sm transition-all duration-300 font-medium cursor-hover">Visual Search</a>
							<a href="#contextual-ease" class="block px-6 py-3 text-slate-300 hover:text-white hover:bg-white/10 hover:pr-4 hover:pl-8 text-sm transition-all duration-300 font-medium cursor-hover">Contextual Ease</a>
							<a href="#mod-manager-linking" class="block px-6 py-3 text-slate-300 hover:text-white hover:bg-white/10 hover:pr-4 hover:pl-8 text-sm transition-all duration-300 font-medium cursor-hover">Mod Manager</a>
							<a href="#unified-importer" class="block px-6 py-3 text-slate-300 hover:text-white hover:bg-white/10 hover:pr-4 hover:pl-8 text-sm transition-all duration-300 font-medium cursor-hover">Unified Importer</a>
							<a href="#deep-configuration" class="block px-6 py-3 text-slate-300 hover:text-white hover:bg-white/10 hover:pr-4 hover:pl-8 text-sm transition-all duration-300 font-medium cursor-hover">Configuration</a>
						</div>
					</div>
					
					<a href="#community" class="text-slate-300 hover:text-white text-sm font-bold tracking-wider uppercase transition-colors py-2 relative group cursor-hover">
						Community
						<span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-onyx-accent transition-all duration-300 group-hover:w-full"></span>
					</a>
				</div>
				
				<div class="flex items-center gap-6 flex-shrink-0">
					<a href="https://github.com/Lasikiewicz/onyx/releases" target="_blank" rel="noopener noreferrer" class="onyx-btn-play text-xs cursor-hover magnetic-btn">
						<span>Download</span>
						<svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
					</a>
				</div>
			</div>
		</nav>

		<!-- Hero Section -->
		<section class="relative min-h-screen flex items-center justify-center overflow-hidden px-8 md:px-24">
			<!-- Transitioning Hero Background -->
			<div class="absolute inset-0 z-0 overflow-hidden">
				{backgroundImages.map((img, idx) => (
					<div class={`absolute inset-0 transition-opacity duration-[3000ms] ease-in-out hero-bg-img ${idx === 0 ? 'opacity-100' : 'opacity-0'}`}>
						<img src={img} alt="" class="w-full h-full object-cover blur-[2px] scale-115 will-change-transform" />
					</div>
				))}
				<!-- Dark Overlay for Readability -->
				<div class="absolute inset-0 bg-black/60"></div>
			</div>
			
			<div class="relative z-10 w-full max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 items-center gap-16">
				<!-- Tagline -->
				<div class="text-center lg:text-left space-y-8 reveal-left">
					<a href="https://github.com/Lasikiewicz/onyx/releases/latest" target="_blank" class="inline-flex py-1 px-4 rounded-full bg-white/5 border border-white/10 text-xs font-bold tracking-widest text-slate-300 mb-4 backdrop-blur-sm shadow-xl items-center gap-2 cursor-hover hover:bg-white/10 hover:scale-105 transition-all text-decoration-none">
						<span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
						<span id="version-tag">LATEST VERSION ({latestVersion})</span>
					</a>
					<h1 class="text-5xl md:text-7xl font-black tracking-tighter leading-[1.1] text-gradient">
						One library for the<br/>games you already own
					</h1>
					<p class="text-slate-400 text-xl lg:text-2xl leading-relaxed max-w-2xl font-light opacity-90 mx-auto lg:mx-0">
						Import your libraries from <span class="text-white font-semibold relative inline-block group">Steam<span class="absolute -bottom-1 left-0 w-full h-0.5 bg-sky-400 scale-x-0 group-hover:scale-x-100 transition-transform origin-left"></span></span>, 
						<span class="text-white font-semibold relative inline-block group">Epic<span class="absolute -bottom-1 left-0 w-full h-0.5 bg-gray-500 scale-x-0 group-hover:scale-x-100 transition-transform origin-left"></span></span>, 
						<span class="text-white font-semibold relative inline-block group">GOG<span class="absolute -bottom-1 left-0 w-full h-0.5 bg-sky-500 scale-x-0 group-hover:scale-x-100 transition-transform origin-left"></span></span>, 
						<span class="text-white font-semibold relative inline-block group">Xbox<span class="absolute -bottom-1 left-0 w-full h-0.5 bg-green-500 scale-x-0 group-hover:scale-x-100 transition-transform origin-left"></span></span> and more, then launch faster from one clean library. 
						Organize once, browse your way, and spend less time juggling launchers.
					</p>
					
					<div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-6 pt-4">
						<a href="https://github.com/Lasikiewicz/onyx/releases" target="_blank" class="onyx-btn-play !px-10 !py-5 text-lg cursor-hover magnetic-btn w-full sm:w-auto">
							Download for Windows
						</a>
						<a href="#features" class="px-10 py-5 rounded-full border border-white/20 text-white font-bold tracking-wider hover:bg-white/5 transition-all hover:scale-105 hover:border-onyx-accent cursor-hover w-full sm:w-auto text-center">
							Explore Features
						</a>
					</div>
				</div>

				<!-- Visuals: 3D Mouse-Following Cube -->
				<div class="flex justify-center xl:justify-end reveal-right perspective-container">
					<div class="onyx-cube-wrapper">
						<div class="onyx-cube" id="mouse-cube">
							<div class="cube-face front"><div class="pip"></div></div>
							<div class="cube-face back"><div class="pip"></div></div>
							<div class="cube-face right"><div class="pip"></div></div>
							<div class="cube-face left"><div class="pip"></div></div>
							<div class="cube-face top"><div class="pip"></div></div>
							<div class="cube-face bottom"><div class="pip"></div></div>
						</div>
						<!-- Emerald Glow Core -->
						<div class="cube-glow"></div>
					</div>
				</div>
			</div>
		</section>

		<!-- Why Onyx -->
		<section class="relative z-10 py-12 px-8 md:px-24 border-t border-white/5 bg-gradient-to-b from-transparent to-black/50">
			<div class="max-w-5xl mx-auto text-center space-y-12 reveal-up">
				<h2 class="text-4xl md:text-6xl font-black tracking-tighter leading-none text-white drop-shadow-2xl">
					Why another launcher...
				</h2>
				<p class="text-slate-300 text-xl lg:text-2xl leading-relaxed font-light opacity-90 mx-auto max-w-4xl">
					So why Onyx? Your games live everywhere Steam, Epic, GOG, Xbox, Ubisoft, EA, and more. Playnite is powerful and flexible. Onyx is for players who want a cleaner, more focused experience with less setup overhead. Its single job is: <span class="text-white font-bold bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-sky-500 hover:tracking-widest transition-all duration-300 inline-block cursor-hover">one library, one place, your way.</span>
				</p>
				<p class="text-slate-300 text-xl lg:text-2xl leading-relaxed font-light opacity-90 mx-auto max-w-4xl mt-6">
					No accounts to sync, no subscription, no clutter. You add your libraries, pick your view (grid, list, logo, or carousel), and customize quickly with a right-click. It’s an open source launcher built for fast daily use, not endless configuration.
				</p>
			</div>
		</section>

		<!-- Features List -->
		<div id="features" class="relative z-10 py-24 px-12">
			<div class="max-w-7xl mx-auto space-y-40">
				{[...collectionViews, ...managementTools, ...advancedFeatures].map((item, index) => {
					const itemId = item.title.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
					const isEven = index % 2 === 0;
					return (
					<div id={itemId} class={`group/section flex flex-col lg:flex-row items-center gap-16 lg:gap-24 scroll-mt-32 `}>
						<!-- Image -->
						<div class={`w-full lg:w-3/5 tilt-card group cursor-hover ${isEven ? 'lg:order-1 reveal-left' : 'lg:order-2 reveal-right'}`}>
							<div class="absolute inset-0 bg-gradient-to-r from-sky-400 to-sky-600 rounded-3xl blur-[40px] opacity-10 group-hover:opacity-40 transition-opacity duration-500"></div>
							<div class="tilt-card-inner glass-panel rounded-3xl overflow-hidden aspect-video border border-white/5 group-hover:border-white/20 transition-all duration-500 lightbox-trigger shadow-2xl relative" data-images={JSON.stringify(item.images)}>
								<!-- Carousel internal logic via markup for now -->
								<div class="absolute inset-0 carousel-container">
									{item.images.map((img, idx) => (
										<div class={`absolute inset-0 transition-opacity duration-1000 ${idx === 0 ? 'opacity-100' : 'opacity-0'} carousel-img`}>
											<img src={img} alt={`${item.title} - ${idx}`} class="w-full h-full object-cover transform transition-transform duration-[10s] hover:scale-110" />
										</div>
									))}
								</div>
								
								{/* Overlay glass icon on hover */}
								<div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
									<div class="w-16 h-16 rounded-full bg-white/10 flex items-center justify-center border border-white/20 transform scale-50 group-hover:scale-100 transition-transform duration-500">
										<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path></svg>
									</div>
								</div>
							</div>
						</div>

						<!-- Text -->
						<div class={`w-full lg:w-2/5 space-y-8 ${isEven ? 'lg:order-2 reveal-right' : 'lg:order-1 reveal-left'}`}>
							<h3 class="text-4xl md:text-5xl lg:text-6xl font-black tracking-tighter leading-none text-white relative inline-block group cursor-default">
								{item.title}
								<span class="absolute -bottom-2 left-0 w-0 h-1 bg-gradient-to-r from-sky-400 to-sky-500 transition-all duration-500 group-hover/section:w-full"></span>
							</h3>
							<p class="text-slate-400 text-xl leading-relaxed font-light opacity-90" set:html={item.desc}></p>
						</div>
					</div>
					);
				})}
			</div>
		</div>

		<!-- Community CTA Section -->
		<section id="community" class="py-32 px-8 relative overflow-hidden bg-black/50 border-t border-white/5 scroll-mt-24">
			<div class="max-w-7xl mx-auto text-center space-y-16 reveal-up">
				<h2 class="text-5xl md:text-7xl font-black tracking-tighter text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-500">Get Involved</h2>
				
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 w-full">
					<!-- Discord -->
					<a href="https://discord.gg/m2dgd4ZUPu" target="_blank" class="group glass-panel p-10 rounded-3xl hover:border-[#5865F2] transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_20px_40px_rgba(88,101,242,0.2)] cursor-hover tilt-card">
						<div class="tilt-card-inner">
							<div class="w-16 h-16 bg-[#5865F2]/10 rounded-2xl flex items-center justify-center mb-8 mx-auto group-hover:scale-110 group-hover:bg-[#5865F2]/20 transition-all duration-300">
								<svg class="w-8 h-8 text-[#5865F2]" fill="currentColor" viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.419-2.157 2.419zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42.001 1.333-.956 2.419-2.157 2.419z"/></svg>
							</div>
							<h3 class="text-3xl font-black mb-2">Discord</h3>
							<p class="text-slate-400 font-light">Join the hub. Chat with devs and fellow users.</p>
						</div>
					</a>
					
					<!-- Reddit -->
					<a href="https://www.reddit.com/r/OnyxLauncher/" target="_blank" class="group glass-panel p-10 rounded-3xl hover:border-[#FF4500] transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_20px_40px_rgba(255,69,0,0.2)] cursor-hover tilt-card">
						<div class="tilt-card-inner">
							<div class="w-16 h-16 bg-[#FF4500]/10 rounded-2xl flex items-center justify-center mb-8 mx-auto group-hover:scale-110 group-hover:bg-[#FF4500]/20 transition-all duration-300">
